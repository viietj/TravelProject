				<div class="row">
					
		@foreach (var item in ViewBag.Tours)
{
    <div class="col-md-4 ftco-animate">

        <div class="project-wrap">

            <a href="/Tour/Detail/@item.TourID"
               class="img"
               style="background-image:url('@item.ImageUrl')">

                <span class="price">
                    @item.PricePerPerson.ToString("N0") VND/person
                </span>
            </a>

            <div class="text p-4">

                <span class="days">
                    @item.DurationDays Days Tour
                </span>

                <h3>
                    <a href="/Tour/Detail/@item.TourID">@item.Title</a>
                </h3>

                <p class="location">
                    <span class="fa fa-map-marker"></span>
                    @item.Region
                </p>

            </div>
        </div>
    </div>
}

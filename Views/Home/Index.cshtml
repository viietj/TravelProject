				<span class="oi oi-menu"></span> Menu
			</button>

			<div class="collapse navbar-collapse" id="ftco-nav">
				<ul class="navbar-nav ml-auto">
					<li class="nav-item active"><a href="/" class="nav-link">Home</a></li>
					<li class="nav-item"><a asp-controller="Home" asp-action="About" class="nav-link">About</a></li>
					<li class="nav-item"><a asp-controller="Home" asp-action="Destinations" class="nav-link">Destinations</a></li>
					<li class="nav-item"><a asp-controller="Hotel" asp-action="Index" class="nav-link">Hotels</a></li>

@{
    // If there is an id parameter in the URL, use it; otherwise default to 0 to get all comments
    int destId = Context.Request.Query.ContainsKey("id")
        ? int.Parse(Context.Request.Query["id"]!)
        : 0;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
}


<section class="tf-section">
    <div class="tf-header">
        <span class="tf-eyebrow">Testimonial</span>
        <h2 class="tf-title">Tourist Feedback</h2>
    </div>
    <div id="featured-area">
        
    </div>
</section>


<section class="comments-section" data-destination-id="@destId">

    <div class="cs-header">
        <h2 class="cs-title">
            <span id="cs-total">0</span>  Guest Reviews
        </h2>
    </div>

    
    <div id="comment-list"></div>

   
    <div class="cs-pagination" id="cs-pagination"></div>

   
    @if (Context.Session.GetInt32("UserID") != null && destId > 0)
    {
        <div class="cs-add-comment">
            <h3 class="cs-add-title">Write Your Review</h3>
            <form id="add-comment-form"
                  enctype="multipart/form-data"
                  action="/Home/AddComment"
                  method="post">

                <input type="hidden" name="DestinationID" value="@destId" />
                <input type="hidden" name="UserName"
                       value="@Context.Session.GetString("UserName")" />

                
                <div class="cs-star-picker" id="star-picker">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="cs-star" data-val="@i">★</span>
                    }
                </div>
                <input type="hidden" name="Rating" id="rating-input" value="5" />

                <textarea name="Content"
                          class="cs-textarea"
                          placeholder="Share your experience..."
                          rows="3"></textarea>

                <!-- Upload ảnh -->
                <label class="cs-upload-btn">
                     Add Image
                    <input type="file" name="ImageFile" accept="image/*" hidden />
                </label>
                <div id="img-preview"></div>

                <button type="submit" class="cs-submit-btn">Submit Review</button>
            </form>
        </div>
    }
    else
    {
        <p class="cs-login-prompt">
            <a href="/Account/Login">Log in</a> to write a review.
        </p>
    }

</section>

@section Scripts {
<script>
(function () {
    const section = document.querySelector('.comments-section');
    const destId  = section.dataset.destinationId;
    let currentPage = 1;
    let allComments = [];

    
    function renderStars(rating, size = 15) {
        return Array.from({length: 5}, (_, i) =>
            `<svg width="${size}" height="${size}" viewBox="0 0 24 24"
                  fill="${i < rating ? '#F59E0B' : 'none'}"
                  stroke="${i < rating ? '#F59E0B' : '#D1D5DB'}"
                  stroke-width="1.5">
               <polygon points="12,2 15.09,8.26 22,9.27 17,14.14
                                18.18,21.02 12,17.77 5.82,21.02
                                7,14.14 2,9.27 8.91,8.26"/>
             </svg>`
        ).join('');
    }

   
    function avatarColor(name) {
        const colors = ['#DBEAFE','#D1FAE5','#FCE7F3','#FDE8CC','#EDE9FE'];
        let hash = 0;
        for (let c of name) hash += c.charCodeAt(0);
        return colors[hash % colors.length];
    }

    function avatarTextColor(name) {
        const colors = ['#1D4ED8','#065F46','#9D174D','#92400E','#5B21B6'];
        let hash = 0;
        for (let c of name) hash += c.charCodeAt(0);
        return colors[hash % colors.length];
    }

    function initials(name) {
        return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    }

    
    function renderComment(c, isReply = false) {
        const date       = new Date(c.createdDate).toLocaleDateString('en-US');
        const adminBadge = c.isAdmin
            ? `<span class="cs-admin-badge">✦ Admin</span>` : '';

        const imageHtml = (!isReply && c.imageUrl)
            ? `<img src="${c.imageUrl}" class="cs-comment-img" alt="Review image" />` : '';

        const starsHtml = (!isReply && c.rating)
            ? `<div class="cs-stars">${renderStars(c.rating)}</div>` : '';

        const repliesHtml = (!isReply && c.replies?.length)
            ? `<div class="cs-replies">
                 ${c.replies.map(r => renderComment(r, true)).join('')}
               </div>` : '';

        const replyForm = !isReply
            ? `<div class="cs-reply-form" id="reply-form-${c.commentID}" style="display:none;">
                 <textarea class="cs-reply-textarea"
                           placeholder="Write a reply..."></textarea>
                 <button class="cs-reply-submit"
                         onclick="submitReply(${c.commentID}, ${c.destinationID})">
                   Send
                 </button>
               </div>` : '';

        return `
        <div class="cs-comment ${isReply ? 'cs-reply' : ''}" id="comment-${c.commentID}">
            <div class="cs-comment-header">
                <div class="cs-avatar"
                     style="background:${avatarColor(c.userName)};
                            color:${avatarTextColor(c.userName)}">
                    ${initials(c.userName)}
                </div>
                <div class="cs-comment-meta">
                    <span class="cs-username">${c.userName}</span>
                    ${adminBadge}
                    <span class="cs-date">${date}</span>
                </div>
            </div>
            ${starsHtml}
            <p class="cs-comment-text">${c.content}</p>
            ${imageHtml}
            <div class="cs-comment-actions">
                <button class="cs-like-btn ${c.isLiked ? 'liked' : ''}"
                        onclick="toggleLike(${c.commentID}, this)">
                    ♥ <span class="cs-like-count">${c.likes}</span>
                </button>
                ${!isReply
                    ? `<button class="cs-reply-toggle"
                               onclick="toggleReplyForm(${c.commentID})">
                          Reply
                       </button>`
                    : ''}
            </div>
            ${replyForm}
            ${repliesHtml}
        </div>`;
    }

    
    function avgRating(comments) {
        const rated = comments.filter(c => c.rating);
        if (!rated.length) return '–';
        return (rated.reduce((s, c) => s + c.rating, 0) / rated.length).toFixed(1);
    }

    
    function renderFeatured(comments) {
        const topRated = [...comments]
            .filter(c => c.rating)
            .sort((a, b) => b.likes - a.likes);

        if (!topRated.length) return;

        const feat   = topRated[0];
        const smalls = topRated.slice(1, 3);

        const smallCards = smalls.map(s => `
            <div class="tf-small-card">
                <div class="tf-sm-top">
                    <div>${renderStars(s.rating, 12)}</div>
                    <span class="tf-loc-badge">
                         ${s.userName}
                    </span>
                </div>
                <p class="tf-sm-quote">${s.content}</p>
                <div class="tf-sm-author">
                    <div class="tf-avatar-sm"
                         style="background:${avatarColor(s.userName)};
                                color:${avatarTextColor(s.userName)}">
                        ${initials(s.userName)}
                    </div>
                    <span class="tf-sm-name">${s.userName}</span>
                </div>
            </div>`).join('');

        const totalReviews = document.getElementById('cs-total').textContent;

        document.getElementById('featured-area').innerHTML = `
        <div class="tf-grid">

            <!-- Card lớn -->
            <div class="tf-featured">
                <div class="tf-featured-body">
                    <div>${renderStars(feat.rating, 18)}</div>
                    <p class="tf-quote">${feat.content}</p>
                    ${feat.imageUrl
                        ? `<img src="${feat.imageUrl}"
                                class="tf-feat-img-bottom"
                                alt="Review image" />`
                        : ''}
                    <div class="tf-author-row">
                        <div class="tf-avatar"
                             style="background:${avatarColor(feat.userName)};
                                    color:${avatarTextColor(feat.userName)}">
                            ${initials(feat.userName)}
                        </div>
                        <div>
                            <p class="tf-author-name">${feat.userName}</p>
                            <p class="tf-author-sub">Traveler · Verified Review</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: 2 card nhỏ + stats -->
            <div class="tf-small-stack">
                ${smallCards}
                <div class="tf-stats-box">
                    <div class="tf-stat">
                        <span class="tf-stat-val">${avgRating(comments)}</span>
                        <span class="tf-stat-label">Avg Score</span>
                    </div>
                    <div class="tf-stat">
                        <span class="tf-stat-val">${totalReviews}</span>
                        <span class="tf-stat-label">Reviews</span>
                    </div>
                    <div class="tf-stat">
                        <span class="tf-stat-val">98%</span>
                        <span class="tf-stat-label">Satisfied</span>
                    </div>
                </div>
            </div>

        </div>`;
    }

    
    function loadComments(page) {
        currentPage = page;
        fetch(`/Home/GetComments?destinationId=${destId}&page=${page}`)
            .then(r => r.json())
            .then(data => {
                document.getElementById('cs-total').textContent = data.totalCount;

                
                if (page === 1) {
                    allComments = data.comments;
                    renderFeatured(data.comments);
                }

                document.getElementById('comment-list').innerHTML =
                    data.comments.map(c => renderComment(c)).join('');

                renderPagination(data.currentPage, data.totalPages);

                
                if (page > 1) {
                    document.getElementById('comment-list')
                        .scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
    }

    
    function renderPagination(current, total) {
        const el = document.getElementById('cs-pagination');
        if (total <= 1) { el.innerHTML = ''; return; }

        let html = '';
        for (let i = 1; i <= total; i++) {
            html += `<button class="cs-page-btn ${i === current ? 'active' : ''}"
                             onclick="loadPage(${i})">${i}</button>`;
        }
        el.innerHTML = html;
    }

    
    window.loadPage = (p) => loadComments(p);

    window.toggleReplyForm = (commentId) => {
        const form = document.getElementById(`reply-form-${commentId}`);
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
        if (form.style.display === 'block') {
            form.querySelector('textarea').focus();
        }
    };

    window.submitReply = (parentId, dId) => {
        const form    = document.getElementById(`reply-form-${parentId}`);
        const content = form.querySelector('textarea').value.trim();
        if (!content) {
            form.querySelector('textarea').style.borderColor = '#ef4444';
            return;
        }

        fetch('/Home/AddReply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `destinationId=${dId}&parentCommentId=${parentId}&content=${encodeURIComponent(content)}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                loadComments(currentPage);
            } else {
                alert(data.message);
            }
        });
    };

    window.toggleLike = (commentId, btn) => {
        fetch('/Home/ToggleLike', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `commentId=${commentId}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                btn.classList.toggle('liked', data.isLiked);
                btn.querySelector('.cs-like-count').textContent = data.likes;
            } else {
                alert(data.message);
            }
        });
    };

    
    document.querySelectorAll('.cs-star').forEach(star => {
        star.addEventListener('mouseover', () => {
            const val = +star.dataset.val;
            document.querySelectorAll('.cs-star').forEach((s, i) => {
                s.style.color = i < val ? '#F59E0B' : '#d1d5db';
            });
        });
        star.addEventListener('mouseout', () => {
            const selected = +document.getElementById('rating-input').value;
            document.querySelectorAll('.cs-star').forEach((s, i) => {
                s.style.color = i < selected ? '#F59E0B' : '#d1d5db';
            });
        });
        star.addEventListener('click', () => {
            const val = +star.dataset.val;
            document.getElementById('rating-input').value = val;
            document.querySelectorAll('.cs-star').forEach((s, i) => {
                s.style.color = i < val ? '#F59E0B' : '#d1d5db';
            });
        });
    });

   
    const fileInput = document.querySelector('input[name="ImageFile"]');
    if (fileInput) {
        fileInput.addEventListener('change', () => {
            const preview = document.getElementById('img-preview');
            const file    = fileInput.files[0];
            if (!file) { preview.innerHTML = ''; return; }
            const reader  = new FileReader();
            reader.onload = e => {
                preview.innerHTML = `
                    <div style="position:relative;display:inline-block;margin-top:8px;">
                        <img src="${e.target.result}"
                             style="max-height:120px;border-radius:8px;" />
                        <button onclick="clearPreview()"
                                style="position:absolute;top:-6px;right:-6px;
                                       background:#ef4444;color:#fff;border:none;
                                       border-radius:50%;width:20px;height:20px;
                                       cursor:pointer;font-size:12px;">✕</button>
                    </div>`;
            };
            reader.readAsDataURL(file);
        });
    }

    window.clearPreview = () => {
        document.getElementById('img-preview').innerHTML = '';
        document.querySelector('input[name="ImageFile"]').value = '';
    };

    loadComments(1);
})();
</script>
}

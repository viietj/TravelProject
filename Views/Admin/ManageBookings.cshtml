@model List<TravelProject.Models.Booking>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Bookings";
}

<style>
    .filter-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .filter-btn {
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        border: 1.5px solid #dee2e6;
        color: #495057;
        background: white;
        transition: all 0.2s;
    }
    .filter-btn:hover { background: #f8f9fa; }
    .filter-btn.active-all    { background: #343a40; color: white; border-color: #343a40; }
    .filter-btn.active-pending  { background: #fff3cd; color: #856404; border-color: #ffc107; }
    .filter-btn.active-confirmed { background: #d1e7dd; color: #0a3622; border-color: #198754; }
    .filter-btn.active-cancelled { background: #f8d7da; color: #842029; border-color: #dc3545; }

    .stat-cards { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
    .stat-card {
        flex: 1; min-width: 150px;
        background: white;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        border-top: 4px solid #dee2e6;
    }
    .stat-card.pending  { border-top-color: #ffc107; }
    .stat-card.confirmed { border-top-color: #198754; }
    .stat-card.cancelled { border-top-color: #dc3545; }
    .stat-card .stat-num { font-size: 2rem; font-weight: 800; color: #1a1a2e; }
    .stat-card .stat-label { font-size: 0.82rem; color: #888; font-weight: 600; }

    .booking-table { width: 100%; border-collapse: collapse; }
    .booking-table th {
        background: #f8f9fa;
        padding: 12px 16px;
        text-align: left;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        border-bottom: 2px solid #dee2e6;
    }
    .booking-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.9rem;
        vertical-align: middle;
    }
    .booking-table tr:hover td { background: #fafafa; }

    .badge-status {
        padding: 5px 12px; border-radius: 20px;
        font-size: 0.75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        display: inline-block;
    }
    .badge-pending   { background: #fff3cd; color: #856404; }
    .badge-confirmed { background: #d1e7dd; color: #0a3622; }
    .badge-cancelled { background: #ffb84d; color: #842029; }

    .action-btns { display: flex; gap: 6px; }
    .btn-confirm {
        padding: 6px 14px; border-radius: 6px;
        background: #198754; color: white;
        border: none; cursor: pointer;
        font-size: 0.8rem; font-weight: 600;
        transition: background 0.2s;
    }
    .btn-confirm:hover { background: #146c43; }
    .btn-cancel-admin { padding: 6px 14px; border-radius: 6px; background: #ff7f27; color: white;
        border: none; cursor: pointer;
        font-size: 0.8rem; font-weight: 600;
        transition: background 0.2s;
    }
    .btn-cancel-admin:hover { background: #e66a00; }

    .table-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    .table-header {
        padding: 20px 24px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .table-header h4 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .alert-success-admin {
        background: #d1e7dd; border: 1px solid #badbcc;
        color: #0a3622; padding: 12px 18px;
        border-radius: 8px; margin-bottom: 20px;
        font-size: 0.9rem;
    }
    .empty-row td {
        text-align: center; padding: 40px;
        color: #999; font-size: 0.95rem;
    }
</style>

<div class="container-fluid">
    <h2 class="mb-4" style="font-weight: 800; color: #1a1a2e;">
        Manage Tour Bookings
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success-admin">✅ @TempData["Success"]</div>
    }

    <!-- Stat Cards -->
    <div class="stat-cards">
        <div class="stat-card pending">
            <div class="stat-num">@ViewBag.PendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
        <div class="stat-card confirmed">
            <div class="stat-num">@ViewBag.ConfirmedCount</div>
            <div class="stat-label">Confirmed</div>
        </div>
        <div class="stat-card cancelled">
            <div class="stat-num">@ViewBag.CancelledCount</div>
            <div class="stat-label">Cancelled</div>
        </div>
        <div class="stat-card">
            <div class="stat-num">@Model.Count</div>
            <div class="stat-label">Showing Now</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <a href="/Admin/ManageBookings"
           class="filter-btn @(ViewBag.StatusFilter == null ? "active-all" : "")">
            All Bookings
        </a>
        <a href="/Admin/ManageBookings?status=Pending"
           class="filter-btn @(ViewBag.StatusFilter == "Pending" ? "active-pending" : "")">
            Pending
        </a>
        <a href="/Admin/ManageBookings?status=Confirmed"
           class="filter-btn @(ViewBag.StatusFilter == "Confirmed" ? "active-confirmed" : "")">
            Confirmed
        </a>
        <a href="/Admin/ManageBookings?status=Cancelled"
           class="filter-btn @(ViewBag.StatusFilter == "Cancelled" ? "active-cancelled" : "")">
            Cancelled
        </a>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-header">
            <h4>Booking List</h4>
            <span style="font-size:0.85rem; color:#888;">@Model.Count result(s)</span>
        </div>
        <div style="overflow-x: auto;">
            <table class="booking-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tour</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Departure</th>
                        <th>Guests</th>
                        <th>Total (VND)</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Booked Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="11">No bookings found for the selected filter.</td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong>#B@b.BookingID</strong></td>
                            <td style="max-width:180px;">
                                <div style="font-weight:600; font-size:0.85rem; line-height:1.3;">@b.Tour?.Title</div>
                            </td>
                            <td>
                                <div style="font-weight:600;">@b.CustomerName</div>
                                <div style="font-size:0.78rem; color:#888;">@b.CustomerEmail</div>
                            </td>
                            <td>@b.CustomerPhone</td>
                            <td>@b.DepartureDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @b.AdultCount adult(s)
                                @if (b.ChildCount > 0)
                                {
                                    <span>, @b.ChildCount child(ren)</span>
                                }
                            </td>
                            <td style="font-weight:700; color:#0d47a1;">@b.TotalPrice.ToString("N0")</td>
                            <td>
                                @if (b.Status == "Pending")
                                {
                                    <span class="badge-status badge-pending">Pending</span>
                                }
                                else if (b.Status == "Confirmed")
                                {
                                    <span class="badge-status badge-confirmed">Confirmed</span>
                                }
                                else if (b.Status == "Completed")
                                {
                                    <span class="badge-status badge-confirmed" style="background:#e0f2fe; color:#0369a1;">Completed</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-cancelled">Cancelled</span>
                                }
                            </td>
                            <td>
                                @if (b.PaymentStatus == "Paid")
                                {
                                    <span class="badge-status badge-confirmed" style="text-transform:none;">Paid</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-cancelled" style="text-transform:none; background:#ffb84d; color:#fff;">Unpaid</span>
                                }
                            </td>
                            <td style="font-size:0.82rem; color:#888;">@b.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="action-btns" style="flex-direction: column; gap: 4px;">
                                @if (b.Status == "Pending")
                                {
                                    <form method="post" action="/Admin/ConfirmBooking" style="margin:0;">
                                        <input type="hidden" name="bookingId" value="@b.BookingID" />
                                        <button type="submit" class="btn-confirm"
                                                onclick="return confirm('Confirm this booking?')">
                                            Confirm
                                        </button>
                                    </form>
                                    <form method="post" action="/Admin/CancelBooking" style="margin:0;">
                                        <input type="hidden" name="bookingId" value="@b.BookingID" />
                                        <button type="submit" class="btn-cancel-admin"
                                                onclick="return confirm('Cancel this booking?')">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else if (b.Status == "Confirmed")
                                {
                                    @if (b.PaymentStatus != "Paid")
                                    {
                                        <form method="post" action="/Admin/ConfirmPayment" style="margin:0;">
                                            <input type="hidden" name="bookingId" value="@b.BookingID" />
                                            <button type="submit" class="btn-confirm" style="background:#0d6efd;"
                                                    onclick="return confirm('Confirm payment manually?')">
                                                Paid Cash
                                            </button>
                                        </form>
                                    }
                                    <form method="post" action="/Admin/CompleteBooking" style="margin:0;">
                                        <input type="hidden" name="bookingId" value="@b.BookingID" />
                                        <button type="submit" class="btn-confirm" style="background:#0dcaf0; color:#000;"
                                                onclick="return confirm('Mark booking as completed?')">
                                            Complete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="color:#bbb; font-size:0.8rem;">No actions</span>
                                }
                                </div>
                            </td>
                        </tr>
                        @if (!string.IsNullOrEmpty(b.Notes))
                        {
                            <tr style="background:#fafafa;">
                                <td colspan="11" style="padding: 6px 16px 14px 16px; font-size:0.82rem; color:#555;">
                                    <strong>Note:</strong> @b.Notes
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tour Management";
}
@model List<TravelProject.Models.Tour>

<div class="card">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-route me-2"></i>Tour List</h5>
        <a href="/TourAdmin/Create" class="btn btn-success btn-sm">+ Add New</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-secondary">
                <tr>
                    <th>ID</th>
                    <th>Tour Name</th>
                    <th>Type</th>
                    <th>Region</th>
                    <th>Duration</th>
                    <th>Price/Adult</th>
                    <th>Price/Child</th>
                    <th>Featured</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TourID</td>
                        <td>@t.Title</td>
                        <td>@t.TourType</td>
                        <td>@t.Region</td>
                        <td>@t.DurationDays days @t.DurationNights nights</td>
                        <td>@t.PricePerPerson.ToString("N0") VND</td>
                        <td>@t.PricePerChild.ToString("N0") VND</td>
                        <td>
                            <span class="badge @(t.IsFeatured ? "bg-warning" : "bg-secondary")">
                                @(t.IsFeatured ? "Featured" : "Standard")
                            </span>
                        </td>
                        <td>
                            <a href="/TourAdmin/Edit/@t.TourID" class="btn btn-sm btn-primary">Edit</a>
                            <form method="post" action="/TourAdmin/Delete/@t.TourID" style="display:inline"
                                  onsubmit="return confirm('Delete this tour?')">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>